<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- 背景圆形 -->
  <circle cx="256" cy="256" r="240" fill="#1890ff" stroke="#096dd9" stroke-width="8"/>
  
  <!-- 虫洞图标 - 两个连接的圆环 -->
  <circle cx="200" cy="200" r="60" fill="none" stroke="white" stroke-width="12" stroke-linecap="round"/>
  <circle cx="312" cy="312" r="60" fill="none" stroke="white" stroke-width="12" stroke-linecap="round"/>
  
  <!-- 连接线 -->
  <path d="M 260 200 Q 256 256 252 312" stroke="white" stroke-width="8" stroke-linecap="round"/>
  
  <!-- 数据流点 -->
  <circle cx="256" cy="256" r="4" fill="white"/>
  <circle cx="240" cy="240" r="3" fill="white"/>
  <circle cx="272" cy="272" r="3" fill="white"/>
</svg>
