{
  "name": "chongdong",
  "version": "1.0.0",
  "description": "虫洞 - 新一代跨平台代理客户端应用",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/your-username/chongdong",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/chongdong.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "electron-builder",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "prepare": "husky install"
  },
  "keywords": [
    "proxy",
    "client",
    "electron",
    "react",
    "typescript",
    "chongdong",
    "虫洞",
    "代理"
  ],
  "author": "ChongDong Team",
  "license": "MIT",
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/semver": "^7.7.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/dns2": "^2.0.9",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/uuid": "^10.0.0",
    "@types/yaml": "^1.9.6",
    "antd": "^5.0.0",
    "axios": "^1.0.0",
    "dns2": "^2.1.0",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.0.0",
    "js-base64": "^3.7.8",
    "lodash": "^4.17.21",
    "lru-cache": "^11.1.0",
    "node-fetch": "^3.0.0",
    "node-forge": "^1.3.1",
    "openvpn-client": "^0.0.2",
    "react": "^18.0.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.0.0",
    "socks": "^2.8.7",
    "utun": "^2.1.0",
    "uuid": "^11.1.0",
    "wireguard-tools": "^0.1.0",
    "yaml": "^2.8.1",
    "zustand": "^5.0.7"
  },
  "build": {
    "appId": "com.chongdong.app",
    "productName": "虫洞",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "src/renderer/assets",
        "to": "assets"
      }
    ],
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
