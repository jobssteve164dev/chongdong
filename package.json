{
  "name": "chongdong",
  "version": "1.0.2",
  "description": "堡垒计划内部的全链路七层网络信任治理与运行客户端",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/jobssteve164dev/chongdong",
  "repository": {
    "type": "git",
    "url": "https://github.com/jobssteve164dev/chongdong.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "electron-builder",
    "test": "jest",
    "test:proxy-runtime": "npm run build:main && node scripts/test-proxy-runtime.cjs",
    "test:geo": "node dist/main/scripts/testGeolocationProtection.js",
    "test:e2e:http-egress": "node dist/main/scripts/testHttpEgressConsistency.js",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "prepare": "husky install"
  },
  "keywords": [
    "proxy",
    "zero-trust",
    "layer-7",
    "electron",
    "react",
    "typescript",
    "chongdong",
    "虫洞",
    "代理链"
  ],
  "author": "ChongDong Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/dns2": "^2.0.9",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.0.0",
    "@types/semver": "^7.7.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.1.1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "antd": "^5.0.0",
    "axios": "^1.20.0",
    "dns2": "^2.1.0",
    "electron-updater": "^6.8.9",
    "js-base64": "^3.7.8",
    "lodash": "^4.18.1",
    "lru-cache": "^10.4.3",
    "react": "^18.0.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.0.0",
    "socks": "^2.8.9",
    "uuid": "^11.1.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.7"
  },
  "overrides": {
    "rollup": "^4.21.3",
    "js-yaml": "^4.3.1"
  },
  "build": {
    "appId": "com.chongdong.app",
    "productName": "虫洞",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "src/renderer/assets",
        "to": "assets"
      }
    ],
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "artifactName": "ChongDong-${version}-macOS-x64.${ext}",
      "category": "public.app-category.utilities"
    },
    "win": {
      "artifactName": "ChongDong-${version}-Windows-x64-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "artifactName": "ChongDong-${version}-Linux-x64.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
